# Production env for WerSu.
# This is a TEMPLATE - do not edit it directly. Run from the repo root:
#   ./scripts/generate-prod-env.py
# which writes a populated .env.prod next to docker-compose.prod.yaml.
#
# Then deploy with:
#   docker compose -f docker-compose.prod.yaml --env-file .env.prod up -d
#
# Each @ask:<KEY>@ placeholder is filled in by the script. The script
# knows the default and the validation rule for each key; you only
# see them at the prompt. Keys marked @random: are filled with a
# fresh `openssl rand -hex 64` and you don't need to provide a value.
#
# The file is split into five blocks. Edit values inside a block; the
# block header is just for orientation.

# ============================================================
# ||  PUBLIC CONFIG                                       ||
# ||  Edit on every deploy. Required for prod to come up. ||
# ============================================================

# Tag of the prebuilt images to pull from ghcr.io/kuramasyu/*.
# Bump per release. `:dev` tracks the default-branch build; pin to
# a semver tag (e.g. v0.1.0) for stable deploys.
IMAGE_TAG=v_image_tag

# Apex domain under which the app is reachable. Traefik derives the
# per-service hostnames from this.
DOMAIN=inu-the-bot.com

# Hostname the frontend is served on. Defaults to wersu.inu-the-bot.com.
FRONTEND_HOST=wersu.inu-the-bot.com

# Discord OAuth application credentials (from the Discord Developer
# Portal). Both are public values, but treat CLIENT_SECRET as a
# secret anyway.
DISCORD_CLIENT_ID=v_discord_client_id
DISCORD_CLIENT_SECRET=v_discord_client_secret

# ============================================================
# ||  STORAGE CREDENTIALS                                 ||
# ||  Edit on first deploy; stable until you rotate keys. ||
# ============================================================

# Credentials for the postgres role that owns the app database.
POSTGRES_USER=v_postgres_user
POSTGRES_PASSWORD=c677bbf992eae564437c00feb53a60bb2757417e16551b06dc8d7317c577ffb3
POSTGRES_DB=v_postgres_db

# S3 credentials for garage. The script auto-generates a fresh
# access key + secret on every run, so a new deploy gets clean S3
# credentials without any manual setup.
GARAGE_DEFAULT_ACCESS_KEY=4e11fd8b492ad445338f6f3dfcd000ed
GARAGE_DEFAULT_SECRET_KEY=f470fa4a86d05bad146b671aa7b8d7353634601b1dada6a38a5ac27d352b8bdd
GARAGE_DEFAULT_BUCKET=bucket

# ============================================================
# ||  AUTO-GENERATED SECRETS                              ||
# ||  Filled by the script. Don't edit by hand.           ||
# ============================================================

# Password for the `spicedb` Postgres role, created by pgvector_init.sql.
SPICEDB_PASSWORD=7fee60d35d9ea9d87cecbf42cf73f55169f943516bc90cb4116f69496269f68d

# Preshared key the gRPC services use to talk to SpiceDB. Must match
# the `--grpc-preshared-key` passed to spicedb.
GRPC_SPICEDB_CREDENTIALS=3b772818a8abc0aae01f7fb7843ed7b52c3344f5bc1e112c2dc1f8fc07cd3765

# Shared secret used by WerSu-gRPC to mint/verify JWTs. Must match
# the JWT_SECRET passed to wersu-rest and hocuspocus.
JWT_SECRET=49a4c15103902267f36bccd841ecf739e5e46d862ef6f2a466d012dc450d1b8379f3686d342048a16e6765380d175aa8fd1dbbd85ffcbb31e95d17bf97f831dd

# Used by wersu-rest to sign session cookies.
SESSION_SECRET=703a30f3d7e210081d8cf415080e742f0e41c5fac2c6f2549925bf3d0f907648e3d7390d918ed37fa85e6c69c3eedc367a85af9ac99b78486b1e19fd570a3e15

# ============================================================
# ||  DERIVED URLS                                        ||
# ||  Computed from the values above. Don't edit.        ||
# ============================================================

# Public URL the Discord OAuth flow redirects to. Must be the
# wersu-rest public URL + the callback path.
DISCORD_REDIRECT_URI=https://api.inu-the-bot.com/api/auth/discord/callback

# Public URL of the frontend. Used for CORS / post-login redirects.
FRONTEND_URL=https://wersu.inu-the-bot.com

# Public URL of the wersu-rest API. Used in Discord embed links,
# OAuth callbacks, etc. Must be reachable from the browser.
BACKEND_URL=https://api.inu-the-bot.com

# Public URL of imgproxy. Used by wersu-rest to construct image
# URLs returned to the browser.
IMGPROXY_ADDRESS=https://img.inu-the-bot.com

# ============================================================
# ||  SERVICE RUNTIME CONFIG                              ||
# ||  Internal addresses and ports. Don't edit unless     ||
# ||  you know what you're doing.                         ||
# ============================================================

# werSu-gRPC: how it listens and which backends it talks to.
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
GRPC_SPICEDB_ADDRESS=spicedb:50051
DATABASE_DSN=postgres://v_postgres_user:c677bbf992eae564437c00feb53a60bb2757417e16551b06dc8d7317c577ffb3@postgres:5432/v_postgres_db?sslmode=disable
S3_ENDPOINT=http://garage:3900
S3_REGION=bucket

# werSu-REST: how it listens and where it finds werSu-gRPC.
REST_HOST=0.0.0.0
REST_PORT=8080
GRPC_SERVER_ADDRESS=wersu-grpc:50052

# imgproxy: S3 backend.
IMGPROXY_USE_S3=true
IMGPROXY_S3_ENDPOINT=http://garage:3900
IMGPROXY_S3_REGION=bucket
IMGPROXY_S3_ALLOWED_BUCKETS=bucket
AWS_ACCESS_KEY_ID=4e11fd8b492ad445338f6f3dfcd000ed
AWS_SECRET_ACCESS_KEY=f470fa4a86d05bad146b671aa7b8d7353634601b1dada6a38a5ac27d352b8bdd

# Hocuspocus: where to find SpiceDB.
SPICEDB_ADDRESS=spicedb:50051

# ============================================================
# ||  VITE BUILD ARGS (frontend image)                    ||
# ||  NOT read by docker compose. Baked into the image at ||
# ||  build time. Reference only.                         ||
# ============================================================
#   VITE_BACKEND_URL=https://api.inu-the-bot.com
#   VITE_HOCUSPOCUS_WS_URL=wss://ws.inu-the-bot.com

