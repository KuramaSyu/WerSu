# the WerSu gRPC container
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# SpiceDB connection
GRPC_SPICEDB_CREDENTIALS="somerandomkeyhere"
GRPC_SPICEDB_ADDRESS="spicedb:50051"

# python start param
PYTHONTRACEMALLOC=1

# garage config
GARAGE_DEFAULT_ACCESS_KEY=c170cb4c3726fa9f0ca9fca11bed021f
GARAGE_DEFAULT_SECRET_KEY=b21cd517badda12cde455f125d32babd253c2ebefebc48eb91064791fe9e2a9c
GARAGE_DEFAULT_BUCKET=garage

# garage for docker, localhost when running on machine
S3_ENDPOINT=http://garage:3900

# for hocuspocus we need the same JWT secret as the Go REST API uses
JWT_SECRET=$(openssl rand -hex 64)

# WebAuthn / passkeys, read by the Go REST API. WEBAUTHN_RP_ID is the
# registrable domain (no scheme, no port); `localhost` is valid for
# http://localhost dev. Leaving it empty disables every passkey route.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=WerSu

# Attachment trash cleanup background service.
# How often the sweep runs, how long an unlinked attachment is kept
# before it is trashed, and how long a trashed attachment is kept
# before it is purged from storage.  All values are seconds.
ATTACHMENT_TRASH_INTERVAL_SECONDS=3600
ATTACHMENT_TRASH_GRACE_SECONDS=86400
ATTACHMENT_TRASH_RETENTION_SECONDS=2592000

# Public URL of the hocuspocus websocket server. The frontend reads
# this at runtime to open the live-edit socket.
HOCUSPOCUS_WS_URL=ws://localhost:8666
